APP_ENV=development
APP_SECRET_KEY=replace-me-locally
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/risheh_digital_goods
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=["http://localhost:3000"]

# Web / Vercel
# REQUIRED in production unless NEXT_PUBLIC_ENABLE_DEMO_MODE=true.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Demo fallback is opt-in. Keep false for every real payment environment.
NEXT_PUBLIC_ENABLE_DEMO_MODE=false

# Provider adapter. Keep real credentials outside git.
DIGITAL_GOODS_PROVIDER=mock
PROVIDER_BASE_URL=
PROVIDER_CLIENT_ID=
PROVIDER_CLIENT_SECRET=

# Payment adapter
PAYMENT_PROVIDER=mock
PAYMENT_MERCHANT_ID=
PAYMENT_SECRET=
PAYMENT_CALLBACK_URL=http://localhost:8000/api/v1/payments/callback

# Delivery encryption key must be generated securely outside source control.
# Any long random string works (it is hashed into a Fernet key internally).
DELIVERY_ENCRYPTION_KEY=

# Gates /api/v1/admin/*. Leave unset to keep admin endpoints disabled (503).
ADMIN_API_KEY=

SENTRY_DSN=
