# ==========================================================
# Risheh Pay — VPS Production Environment
# Copy to .env.production on the server. NEVER commit secrets.
# ==========================================================

APP_ENV=production
SEED_DEMO_CATALOG=false

# Public URL used by the Next.js build and browser.
# Recommended: same-origin API through Nginx, e.g. https://pay.example.com
PUBLIC_BASE_URL=https://pay.example.com
NEXT_PUBLIC_API_URL=https://pay.example.com
NEXT_PUBLIC_ENABLE_DEMO_MODE=false

# PostgreSQL — replace every placeholder with a strong unique value.
POSTGRES_DB=risheh_pay
POSTGRES_USER=risheh_pay
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_DB_PASSWORD
DATABASE_URL=postgresql+asyncpg://risheh_pay:CHANGE_ME_STRONG_RANDOM_DB_PASSWORD@postgres:5432/risheh_pay

# Redis is private to the Docker network and password protected.
REDIS_PASSWORD=CHANGE_ME_STRONG_RANDOM_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STRONG_RANDOM_REDIS_PASSWORD@redis:6379/0

# API security
APP_SECRET_KEY=CHANGE_ME_64_PLUS_RANDOM_CHARS
DELIVERY_ENCRYPTION_KEY=CHANGE_ME_64_PLUS_RANDOM_CHARS
ADMIN_API_KEY=CHANGE_ME_64_PLUS_RANDOM_CHARS
CORS_ORIGINS=["https://pay.example.com"]

# Digital-goods provider — never use mock in a real-money environment.
DIGITAL_GOODS_PROVIDER=CHANGE_ME_REAL_PROVIDER
PROVIDER_BASE_URL=
PROVIDER_CLIENT_ID=
PROVIDER_CLIENT_SECRET=

# Payment provider — never use mock in a real-money environment.
PAYMENT_PROVIDER=CHANGE_ME_REAL_PAYMENT_PROVIDER
PAYMENT_MERCHANT_ID=
PAYMENT_SECRET=
PAYMENT_CALLBACK_URL=https://pay.example.com/api/v1/payments/callback

# Reverse proxy
SERVER_NAME=pay.example.com

# Optional observability
SENTRY_DSN=

# Backup retention
BACKUP_RETENTION_DAYS=14
